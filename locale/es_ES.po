msgid "* \"Toy Knife\" - Weapon AT 3&* Made of plastic.&* A rarity nowadays./%"
msgstr "* \"Cuchillo Juguete\" - Arma AT 3&* Hecho de plástico.&* Una rareza hoy en día./%"

msgid "* \"Tough Glove\" - Weapon AT 5&* A worn pink leather glove^1.&* For five-fingered folk./%"
msgstr "* \"Guante Duro\" - Arma AT 5&* Un guante de cuero rosa.^1 &* Para gente con cinco dedos./%"

msgid "* \"Manly Bandanna\" - Armor DF 7&* It has seen some wear.&* It has abs drawn on it./%"
msgstr "* \"Bandana Mascul.\" - Armad DF 7&* Ha sido usada bastante.&* Tiene abdominales dibujados./%"

msgid "* \"Snowman Piece\" - Heals 45 HP&* Please take this to the&  ends of the earth./%"
msgstr "* \"Trozo de Nieve\" - Cura 45 PS&* Por favor, lleva esto a los&  confines de la tierra./%"

msgid "* \"Nice Cream\" - Heals 15 HP&* Instead of a joke,^1 the&  wrapper says something nice./%"
msgstr "* \"Heladito\" - Cura 15 PS&* En vez de un chiste,^1 el&  envoltorio dice algo bonito./%"

msgid "* \"Puppydough Icecream\"&* Heals 28 HP^1.&* Made by young pups./%"
msgstr ""

msgid "* \"Bisicle\" - Heals 11 HP&* It's a two-pronged popsicle^1,&  so you can eat it twice./%"
msgstr "* \"Bipolo\" - Cura 11 PS&* Es un polo de dos puntas,^1 para&  poder comértelo dos veces./%"

msgid "* \"Unisicle\" - Heals 11 HP&* It's a SINGLE-pronged popsicle^1.&* Wait^1, that's just normal.../%"
msgstr "* \"Unipolo\" - Cura 11 PS&* Es un polo de una SOLA punta.^1 &* Espera,^1 eso es lo normal.../%"

msgid "* \"Cinnamon Bunny\" - Heals 22 HP&* A cinnamon roll in the shape&  of a bunny./%%"
msgstr "* \"Conejo de Canela\" - Cura 22 PS&* Un rollo de canela con forma&  de conejo./%%"

msgid "* \"Temmie Flakes\" - Heals 2 HP&* It's just torn up pieces&  of colored construction paper./%%"
msgstr "* \"Copos de Temmie\" - Cura 2 PS&* Sólo son trozos rotos de&  cartulina de colores./%%"

msgid "* \"Abandoned Quiche\" Heals 34 HP&* A psychologically damaged&  spinach egg pie./%%\""
msgstr "* \"Quiche Abandonada\" Cura 34 PS&* Un pastel de huevo y espinaca&  psicologicamente dañado./%%"

msgid "* \"Old Tutu\" - Armor DF 10&* Finally^1, a protective piece&  of armor./%%"
msgstr "* \"Tutú Viejo\" - Armad DF 10&* Por fin,^1 una pieza de armadura&  protectora./%%"

msgid "* \"Ballet Shoes\" - Wpn AT 7&* These used shoes make you&  feel incredibly dangerous./%%"
msgstr "* \"Zapatos de Ballet\" - Arma AT 7&* Estos zapatos usados te hacen&  sentir de lo más peligroso./%%"

msgid "* \"Punch Card\" - Battle Item&* Use to make punching attacks&  stronger in one battle./"
msgstr "* \"Tarjeta Perf\" - Combate&* Usar para hacer ataques de&  golpe más fuertes un combate./"

msgid "* Use outside of battle to&  look at the card./%%"
msgstr "* Usar fuera de combate para&  ver la tarjeta./%%"

msgid "* \"Annoying Dog\" - Dog&* A little white dog^1.&* It's fast asleep.../%%"
msgstr "* \"Perro molesto\" - Perro&* Un pequeño perro blanco.^1 &* Está profundamente dormido.../%%"

msgid "* \"Dog Salad\" - Heals ?? HP&* Recovers HP.&* (Hit Poodles.)/%%"
msgstr "* \"Ensalada Perro\" - Cura ?? PS&* Recupera PS.&* (Golpea poodles.)/%%"

msgid "* \"Dog Residue\" - Dog Item&* Shiny trail left&  behind by a dog./%%"
msgstr "* \"Residuo Perro\" - Item Perro&* Rastro brillante dejado&  por un perro./%%"

msgid "* \"Dog Residue\" - Dog Item&* Dog-shaped husk shed&  from a dog's carapace./%%"
msgstr "* \"Residuo Perro\" - Item Perro&* Cascara en forma de perro&  del caparazón de un perro./%%"

msgid "* \"Dog Residue\" - Dog Item&* Dirty dishes left&  unwashed by a dog./%%"
msgstr "* \"Residuo Perro\" - Item Perro&* Platos sucios dejados&  sin lavar por un perro./%%"

msgid "* \"Dog Residue\" - Dog Item&* Glowing crystals secreted&  by a dog./%%"
msgstr "* \"Residuo Perro\" - Item Perro&* Crestales brillantes&  secretados por un perro./%%"

msgid "* \"Dog Residue\" - Dog Item&* Jigsaw puzzle left&  unfinished by a dog./%%"
msgstr "* \"Residuo Perro\" - Item Perro&* Rompecabezas dejado sin&  terminar por un perro./%%"

msgid "* \"Dog Residue\" - Dog Item&* Web spun by a dog&  to ensnare prey./%%"
msgstr "* \"Residuo Perro\" - Item Perro&* Tela tejida por un perro&  pra atrapar preza./%%"

msgid "* \"Astronaut Food\" Heals 21 HP&* For feeding a pet&  astronaut./%%"
msgstr "* \"Astrocomida\" - Cura 21 PS&* Para alimentar a tu&  astronauta mascota./%%"

msgid "* \"Instant Noodles\" Heals HP&* Comes with everything you&  need for a quick meal!/%%"
msgstr "* \"Fideos Instantáneos\" Cura PS&* ¡Tiene todo lo que necesitas&  para una comida rápida!/%%"

msgid "* \"Crab Apple\" Heals 18 HP&* An aquatic fruit that&  resembles a crustacean./%%"
msgstr "* \"Manzana Cangrejo\" Cura 18 PS&* Una fruta acuática con aspecto&  de crustaceo./%%"

msgid "* \"Hot Dog...?\" Heals 20 HP&* The \"meat\" is made of something&  called a \"water sausage.\"/%%"
msgstr "* \"¿Perrito...?\" Cura 20 PS&* La \"carne\" está hecha de algo&  llamado \"salchicha de agua\"./%%"

msgid "* \"Hot Cat\" Heals 21 HP&* Like a hot dog^1, but with&  little cat ears on the end./%%"
msgstr "* \"Gatito\" Cura 21 PS&* Como un perrito,^1 pero con&  pequeñas orejas de gato./%%"

msgid "* \"Glamburger\" Heals 27 HP&* A hamburger made of edible&  glitter and sequins./%%"
msgstr "* \"Glamburguesa\" Cura 27 PS&* Una hamburguesa hecha de purpu-&  rina y lentejuelas comestibles./%%"

msgid "* \"Sea Tea\" Heals 10 HP&* Made from glowing marshwater.&* Increases SPEED for one battle./%%"
msgstr "* \"Té de Mar\" Cura 10 PS&* Hecho de agua de marisma bri-&  llante. Aumenta la VELOCIDAD./%%"

msgid "* \"Starfait\" Heals 14 HP&* A sweet treat made of&  sparkling stars./%%"
msgstr "* \"Estrellarfait\" Cura 14 PS&* Un aperitivo dulce hecho de&  estrellas chispeantes./%%"

msgid "* \"Legendary Hero\" Heals 40 HP&* Sandwich shaped like a sword.&* Increases ATTACK when eaten./%%"
msgstr "* \"Héroe Legendario\" Cura 40 PS&* Sándwich con forma de espada.&* Aumenta el ATAQUE al comerlo./%%"

msgid "* \"Cloudy Glasses\" - Armor DF 6&* Glasses marred with wear.&* Increases INV by 9./"
msgstr "* \"Gafas Empañadas\" - Armad DF 6&* Gafas estropeadas y gastadas.&* Aumenta la INVENCIBILIDAD 9./"

msgid "* (After you get hurt by an&  attack^1, you stay invulnerable&  for longer.)/%%"
msgstr "* (Cuando te hiere un ataque,^1 &  te mantienes invulnerable&  más tiempo.)/%%"

msgid "* \"Torn Notebook\" - Weapon AT 2&* Contains illegible scrawls.&* Increases INV by 6./%"
msgstr "* \"Libreta Rasgada\" - Arma AT 2&* Contiene garabatos ilegibles.&* Aumenta la INVENCIBILIDAD 6./%"

msgid "* \"Stained Apron\" - Armor DF 11&* Heals 1 HP every other&  turn./%"
msgstr "* \"Delantal Manch.\" - Armad DF 11&* Cura 1 PS en algunos turnos./%"

msgid "* \"Burnt Pan\" - Weapon AT 10&* Damage is rather consistent.&* Consumable items heal 4 more HP./%"
msgstr "* \"Sartén Quemada\" - Arma AT 10&* El daño es bastante normal.&* Los objetos curan 4 PS más./%"

msgid "* \"Cowboy Hat\" - Armor DF 12&* This battle-worn hat makes you&  want to grow a beard./"
msgstr "* \"Sombrero Vaqu.\" - Armad DF 12&* Este sombrero gastado te hace&  querer crecer una barba./"

msgid "* It also raises ATTACK by 5./%"
msgstr "* También aumenta el ATAQUE 5./%"

msgid "* \"Empty Gun\" - Weapon AT 12&* An antique revolver^1.&* It has no ammo./"
msgstr "* \"Pistola Vacía\" - Arma AT 12&* Un revolver antiguo.^1 &* No tiene munición./"

msgid "* Must be used precisely, or&  damage will be low./%"
msgstr "* Debe ser usada de manera&  precisa, o el daño será bajo./%"

msgid "* \"Heart Locket\" - Armor DF 15&* It says \"Best Friends Forever.\"/%"
msgstr "* \"Medallón Cor.\" - Armad DF 15&* Dice \"Mejores Amigos Para&  Siempre\"./%"

msgid "* \"Worn Dagger\" - Weapon AT 15&* Perfect for cutting plants&  and vines./%"
msgstr "* \"Daga Desgastada\" - Arma AT 15&* Perfecta para cortar plantas&  y enredaderas./%"

msgid "* \"Real Knife\" - Weapon AT 99&* Here we are!/%"
msgstr "* \"Cuchillo Real\" - Arma AT 99&* ¡Vamos allá!/%"

msgid "* \"The Locket\" - Armor DF 99&* You can feel it beating./%"
msgstr "* \"El Medallón\" - Armad DF 99&* Puedes sentir como late./%"

