msgstr "* \"Carta de Undyne EX\" - Único&* Tiene escrita NO LA TIRES./%%"

msgid "* \"Popato Chisps\" Heals 13 HP&* Regular old popato chisps./%%"
msgstr "* \"Papatas\" Curan 13 PS&* Una bolsa de papatas fristas&  normal y corriente./%%"

msgid "* \"Junk Food\" Heals 17 HP&* Food that was probably&  once thrown away./%%"
