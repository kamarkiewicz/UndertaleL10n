msgid "* If you are reading this,&  I messed up somehow./%"
msgstr "* Jeśli to czytasz,&  jakoś musiałem coś spieprzyć./%"

msgid "* \"Monster Candy\" - Heals 10 HP&* Has a distinct,^1 &  non-licorice flavor./%"
msgstr "* \"Potworny Cukierek\" Leczy 10 PŻ&* Ma wyraźny,^1 bezlukrecyjny smak./%"

msgid "* \"Croquet Roll\" - Heals 15 HP&* Fried dough traditionally&  served with a mallet./%"
msgstr "* \"Krokiet\" - Leczy 15 PŻ&* Smażone ciasto tradycyjnie&  podany z tłuczkiem./%"

msgid "* \"Stick\" - Weapon AT 0&* Its bark is worse than&  its bite./%"
msgstr "* \"Patyk\" - Broń AT 0&* Jego szczekanie jest gorsze,&  niż jego gryzienie./%"

msgid "* \"Bandage\" - Heals 10 HP&* It has already been used&  several times./%"
msgstr "* \"Bandaż\" - Leczy 10 PŻ&* Już był używany&  z kilka razy./%"

msgid "* \"Rock Candy\" - Heals 1 HP&* Here is a recipe to make&  this at home:/"
msgstr "* \"Kamienny Cukierek\"  Leczy 1 PŻ&* Oto przepis jak przyrządzić to&  sobie w domu:/"

msgid "* 1. Find a rock/%"
msgstr "* 1. Znajdź kamień/%"

msgid "* \"Pumpkin Rings\" - Heals 8 HP&* A small pumpkin cooked&  like onion rings./%"
msgstr "* \"Dyniowe Krążki\" - Leczą 8 PŻ&* Małe dynie usmażone tak samo&  jak cebulowe krążki./%"

msgid "* \"Spider Donut\" - Heals 12 HP&* A donut made with Spider&  Cider in the batter./%"
msgstr "* \"Pajęczy Pączek\" - Leczy 12 PŻ&* Pączek zrobiony z Pajęczego&  Jabłecznika w rzadkim cieście./%"

msgid "* \"Stoic Onion\" - Heals 5 HP&* Even eating it raw^1, the&  tears just won't come./%"
msgstr "* \"Stoicka Cebula\" - Leczy 5 PŻ&* Nie będziesz po niej płakał^1,&  nawet jedząc na surowo./%"

msgid "* \"Ghost Fruit\" - Heals 16 HP&* If eaten^1, it will never&  pass to the other side./%"
msgstr "* \"Duszny Owoc\" - Leczy 16 PŻ&* Gdy go zjesz^1, nigdy nie&  przejdzie na drugą stronę./%"

msgid "* \"Spider Cider\" - Heals 24 HP&* Made with whole spiders^1,&  not just the juice./%"
msgstr "* \"Pajęczy Cydr\" - Leczy 24 PŻ&* Przyrządzony z całymi pająkami^1,&  nie tylko z sokiem./%"

msgid "* \"Butterscotch Pie\" - All HP&* Butterscotch-cinnamon&  pie^1, one slice./%"
msgstr "* \"Ciasto Toffi\" - Leczy całe PŻ&* Toffi-cynamonowe ciasto^1,&  tylko jeden kawałek./%"

msgid "* \"Faded Ribbon\" - Armor DF 3&* If you're cuter^1, monsters&  won't hit you as hard./%"
msgstr "* \"Wyblakła wstęga\" - Zbroja DF 3&* Będąc słodszym^1, potwory&  nie uderzą cię tak mocno./%"

msgid "* \"Toy Knife\" - Weapon AT 3&* Made of plastic.&* A rarity nowadays./%"
msgstr "* \"Nożyk\" - Broń AT 3&* Zabawka wykonana z plastiku.&* Rzadkość w tych czaszach./%"

msgid "* \"Tough Glove\" - Weapon AT 5&* A worn pink leather glove^1.&* For five-fingered folk./%"
msgstr "* \"Mocna Rękawica\" - Broń AT 5&* Stara różowa skórzana rękawica^1.&* Dla rąk z pięcioma palcami./%"

msgid "* \"Manly Bandanna\" - Armor DF 7&* It has seen some wear.&* It has abs drawn on it./%"
msgstr "* \"Męska chusta\" - Pancerz DF 7&* Widać jej zużycie.&* Ma narysowany sześciopak./%"

msgid "* \"Snowman Piece\" - Heals 45 HP&* Please take this to the&  ends of the earth./%"
msgstr "* \"Kawałek Bałwana\" - Leczy 45 PŻ&* Proszę zabierz to na&  koniec świata./%"

msgid "* \"Nice Cream\" - Heals 15 HP&* Instead of a joke,^1 the&  wrapper says something nice./%"
msgstr "* \"Śniezłe Lody\" - Leczą 15 PŻ&* Zamiast żartu,^1 na&  papierku są miłe słowa./%"

msgid "* \"Puppydough Icecream\"&* Heals 28 HP^1.&* Made by young pups./%"
msgstr "* \"Puppydough Icecream\"&* Heals 28 PŻ^1.&* Made by young pups./%"

msgid "* \"Bisicle\" - Heals 11 HP&* It's a two-pronged popsicle^1,&  so you can eat it twice./%"
msgstr "* \"Dwulód na patyku\" Leczy 11 PŻ&* Lód na patyku dla dwojga^1, czyli&  możesz go zjeść dwa razy./%"

msgid "* \"Unisicle\" - Heals 11 HP&* It's a SINGLE-pronged popsicle^1.&* Wait^1, that's just normal.../%"
msgstr "* \"Lód na patyku\" Leczy 11 PŻ&* Lód na patyku dla JEDNEJ osoby^1.&* Czekaj^1, czyli normalny lód.../%"

msgid "* \"Cinnamon Bunny\" - Heals 22 HP&* A cinnamon roll in the shape&  of a bunny./%%"
msgstr "* \"Cynamonowy Królik\" Leczy 22 PŻ&* Cynamonowa rolada w kształcie&  królika./%%"

msgid "* \"Temmie Flakes\" - Heals 2 HP&* It's just torn up pieces&  of colored construction paper./%%"
msgstr "* \"Płatki Temmie\" - Leczą 2 PŻ&* To po prostu podarte kawałki&  papieru kolorowego./%%"

#, fuzzy
msgid "* \"Abandoned Quiche\" Heals 34 HP&* A psychologically damaged&  spinach egg pie./%%\""
msgstr "* \"Porzucona Tarta\" Leczy 34 PŻ&* Psychicznie zszargana&  tarta szpinakowo-jajeczna./%%\""

msgid "* \"Old Tutu\" - Armor DF 10&* Finally^1, a protective piece&  of armor./%%"
msgstr "* \"Stare Tutu\" - Pancerz DF 10&* Nareszcie jakiś porządny&  kawał pancerza./%%"

msgid "* \"Ballet Shoes\" - Wpn AT 7&* These used shoes make you&  feel incredibly dangerous./%%"
msgstr "* \"Baletki\" - Broń AT 7&* Te zużyte buty sprawią, że&  staniesz się groźny./%%"

msgid "* \"Punch Card\" - Battle Item&* Use to make punching attacks&  stronger in one battle./"
msgstr "* \"Mocny Kupon\" Przedmiot Bojowy&* Użyj, by ataki stały się&  mocniejsze na jedną rundę./"

msgid "* Use outside of battle to&  look at the card./%%"
msgstr "* Użyj poza walką, by zobaczyć&  zawartość karty./%%"

msgid "* \"Annoying Dog\" - Dog&* A little white dog^1.&* It's fast asleep.../%%"
msgstr "* \"Nieznośny Pies\" - Pies&* Mały^1, biały pies^1.&* Głęboko śpi.../%%"

msgid "* \"Dog Salad\" - Heals ?? HP&* Recovers HP.&* (Hit Poodles.)/%%"
msgstr "* \"Psiałatka\" - Leczy ?? PŻ&* Psia sałata.&* Odzyskuje PŻ. (Pieskie Życie.)/%%"

msgid "* \"Dog Residue\" - Dog Item&* Shiny trail left&  behind by a dog./%%"
msgstr "* \"Psie resztki\" - Psi Przedmiot&* Błyszcząca ścieżka pozostawiona&  po psie./%%"

msgid "* \"Dog Residue\" - Dog Item&* Dog-shaped husk shed&  from a dog's carapace./%%"
msgstr "* \"Psie resztki\" - Psi Przedmiot&* Psiokształtna łuska, która&  która odpadła od psiej skorupy./%%"

msgid "* \"Dog Residue\" - Dog Item&* Dirty dishes left&  unwashed by a dog./%%"
msgstr "* \"Psie resztki\" - Psi Przedmiot&* Pozostawione brudne naczynia,&  nieumyte przez psa./%%"

msgid "* \"Dog Residue\" - Dog Item&* Glowing crystals secreted&  by a dog./%%"
msgstr "* \"Psie resztki\" - Psi Przedmiot&* Świecące się kryształy&  wydzielone przez psa./%%"

msgid "* \"Dog Residue\" - Dog Item&* Jigsaw puzzle left&  unfinished by a dog./%%"
msgstr "* \"Psie resztki\" - Psi Przedmiot&* Układanka niedokończona&  przez psa./%%"

msgid "* \"Dog Residue\" - Dog Item&* Web spun by a dog&  to ensnare prey./%%"
msgstr "* \"Psie resztki\" - Psi Przedmiot&* Sieć wypuszczona przez psa&  w celu oplątania zdobyczy./%%"

msgid "* \"Astronaut Food\" Heals 21 HP&* For feeding a pet&  astronaut./%%"
msgstr "* \"Pokarm Astronauty\" Leczy 21 PŻ&* Pokarm dla zwierzęcych&  astronautów./%%"

msgid "* \"Instant Noodles\" Heals HP&* Comes with everything you&  need for a quick meal!/%%"
msgstr "* \"Makaron Instant\" Leczy PŻ&* Wszystko, czego trzeba do&  szybkiego posiłku!/%%"

msgid "* \"Crab Apple\" Heals 18 HP&* An aquatic fruit that&  resembles a crustacean./%%"
msgstr "* \"Krabie Jabłko\" - Leczy 18 PŻ&* Morski owoc przypominający&  jakiegoś skorupiaka./%%"

msgid "* \"Hot Dog...?\" Heals 20 HP&* The \"meat\" is made of something&  called a \"water sausage.\"/%%"
msgstr "* \"Hot Dog...?\" Leczy 20 PŻ&* \"Mięso\" jest zrobione z czegoś&  co się zwie \"parówka wodna\"./%%"

msgid "* \"Hot Cat\" Heals 21 HP&* Like a hot dog^1, but with&  little cat ears on the end./%%"
msgstr "* \"Hot Kot\" Leczy 21 PŻ&* Wygląda jak hot dog^1, ale ma&  małe kocie uszka na końcu./%%"

msgid "* \"Glamburger\" Heals 27 HP&* A hamburger made of edible&  glitter and sequins./%%"
msgstr "* \"Blaskburger\" Leczy 27 PŻ&* Hamburger zrobiony z jadalnego&  brokatu i pajet./%%"

msgid "* \"Sea Tea\" Heals 10 HP&* Made from glowing marshwater.&* Increases SPEED for one battle./%%"
msgstr "* \"Morska Herbata\" - Leczy 10 PŻ&* Parzona w wodzie bagiennej.&* Zwiększa SZYBKOŚĆ na 1 atak./%%"

msgid "* \"Starfait\" Heals 14 HP&* A sweet treat made of&  sparkling stars./%%"
msgstr "* \"Gwiazdfait\" Leczy 14 PŻ&* Słodki poczęstunek zrobiony&  z błyszczących gwiazd./%%"

msgid "* \"Legendary Hero\" Heals 40 HP&* Sandwich shaped like a sword.&* Increases ATTACK when eaten./%%"
msgstr "* \"Legendarny Heros\" Leczy 40 PŻ&* Kanapka w kształcie miecza.&* Zwiększa ATAK po spożyciu./%%"

msgid "* \"Cloudy Glasses\" - Armor DF 6&* Glasses marred with wear.&* Increases INV by 9./"
msgstr "* \"Zamglone Okulary\" Pancerz DF 6&* Okulary już mocno znoszone.&* Zwiększają NIEW o 9./"

msgid "* (After you get hurt by an&  attack^1, you stay invulnerable&  for longer.)/%%"
msgstr "* (Gdy zostaniesz zraniony^1,&  będziesz dłużej niewrażliwy&  na ataki.)/%%"

msgid "* \"Torn Notebook\" - Weapon AT 2&* Contains illegible scrawls.&* Increases INV by 6./%"
msgstr "* \"Podarty Zeszyt\" - Broń AT 2&* Pełen nieczytelnych bazgrołów.&* Zwiększa NIEW o 6./%"

msgid "* \"Stained Apron\" - Armor DF 11&* Heals 1 HP every other&  turn./%"
msgstr "* \"Brudny Fartuch\" Zbroja DF 11&* Leczy 1 PŻ co rundę./%"

msgid "* \"Burnt Pan\" - Weapon AT 10&* Damage is rather consistent.&* Consumable items heal 4 more HP./%"
msgstr "* \"Spalona Patelnia\" - Broń AT 10&* W miarę normalne obrażenia.&* Jedzenie leczy o 4 PŻ więcej./%"

msgid "* \"Cowboy Hat\" - Armor DF 12&* This battle-worn hat makes you&  want to grow a beard./"
msgstr "* \"Kapelusz Kowboja\" Zbroja DF 12&* Ten kapelusz idealny na wojnę&  sprawi, że zapuścisz brodę./"

msgid "* It also raises ATTACK by 5./%"
msgstr "* A tak poza tym to&  podnosi ATAK o 5./%"

msgid "* \"Empty Gun\" - Weapon AT 12&* An antique revolver^1.&* It has no ammo./"
msgstr "* \"Rewolwer\" - Broń AT 12&* Zabytkowy rodzaj broni palnej^1.&* Brak w nim amunicji./"

msgid "* Must be used precisely, or&  damage will be low./%"
msgstr "* Trzeba nim dokładnie celować,&  w przeciwnym razie obrażenia&  będą niskie./%"

msgid "* \"Heart Locket\" - Armor DF 15&* It says \"Best Friends Forever.\"/%"
msgstr "* \"Sercowy Medalion\" Zbroja DF 15&* Pisze na nim \"Najlepsi&  Przyjaciele Na Zawsze.\"/%"

msgid "* \"Worn Dagger\" - Weapon AT 15&* Perfect for cutting plants&  and vines./%"
msgstr "* \"Używany Sztylet\" - Broń AT 15&* Idealny do cięcia&  roślin i chwastów./%"

msgid "* \"Real Knife\" - Weapon AT 99&* Here we are!/%"
msgstr "* \"Prawdziwy Nóż\" - Broń AT 99&* Nareszcie!/%"

msgid "* \"The Locket\" - Armor DF 99&* You can feel it beating./%"
msgstr "* \"Medalion\" - Zbroja DF 99&* Czujesz, jak bije./%"

msgid "* \"Bad Memory\" Hurts 1 HP&* ?????/%%"
msgstr "* \"Złe Wspomnienia\" Kaleczą 1 PŻ&* ?????/%%"

msgid "* \"Dream\" Heals 12 HP&* The goal of \"Determination.\"/%%"
msgstr "* \"Marzenie\" Leczy 12 PŻ&* Cel \"Determinacji.\"/%%"

msgid "* \"Undyne's Letter\" - Unique&* Letter written for Dr.&  Alphys./%%"
msgstr "* \"List Undyne\" - Specjalny&* List zaadresowany do Dr.&  Alphys./%%"

msgid "* \"Undyne's Letter EX\" - Unique&* It has DON'T DROP IT&  written on it./%%"
msgstr "* \"List Undyne EX\" - Specjalny&* Napisano na nim NIE UPUŚĆ./%%"

msgid "* \"Popato Chisps\" Heals 13 HP&* Regular old popato chisps./%%"
msgstr "* \"Czipsy\" - Leczą 13 PŻ&* Zwykłe stare czipsy&  ziemniaczane./%%"

msgid "* \"Junk Food\" Heals 17 HP&* Food that was probably&  once thrown away./%%"
msgstr "* \"Śmiecipsy\" Leczą 17 PŻ&* Czipsy, które pewnie zostały&  już wcześniej wyrzucone./%%"

msgid "* \"Mystery Key\" Unique&* It is too bent to fit on&  your keychain./%%"
msgstr "* \"Tajemniczy Klucz\" P. Specjalny&* Jest zbyt zakrzywiony, by go&  zmieścić w breloku na klucze./%%"

msgid "* \"Face Steak\" Heals 60 HP&* Huge steak in the shape&  of Mettaton's face./"
msgstr "* \"Twarzowy Stek\" Leczy 60 PŻ&* Wielki stek w kształcie twarzy&  Mettatona./"

msgid "* (You don't feel like it's&  made of real meat...)/%%"
msgstr "* (Masz przeczucie, że nie jest&  to prawdziwe mięso...)/%%"

msgid "* \"Hush Puppy\" Heals 65 HP&* This wonderful spell will stop&  a dog from casting magic./%%"
msgstr "* \"Cichopiesek\" Leczy 65 PŻ&* To magiczne ciasto kukurydziane&  powstrzyma każdy pieski czar./%%"

msgid "* \"Snail Pie\" - Heals Some HP&* An acquired taste./%%"
msgstr "* \"Ślimacze Ciasto\" Leczy ileś PŻ&* Nabyty smak./%%"

msgid "* \"temy armor\" - Armor DF 20&* The things you can do with&  a college education!/"
msgstr "* \"zbroja tem\" - Pancerz DF 20&* Jedna z rzeczy, które możesz&  zrobić po studiach!/"

msgid "* Raises ATTACK when worn^1.&* Recovers HP every other turn^1.&* INV up slightly./%%"
msgstr "* Zwiększa ATAK^1.&* Odzyskuje PŻ po każdej turze^1.&* Lekko zwiększa NIEW./%%"

