msgid "* If you are reading this,&  I messed up somehow./%"
msgstr "* Wenn du das liest^1, habe&  ich irgendetwas vermasselt./%"

msgid "* \"Monster Candy\" - Heals 10 HP&* Has a distinct,^1 &  non-licorice flavor./%"
msgstr "* \"Monster Bonbon\" - Heilt 10 HP&* Hat einen deutlichen&  Anti-Lakritz Geschmack./%"

msgid "* \"Croquet Roll\" - Heals 15 HP&* Fried dough traditionally&  served with a mallet./%"
msgstr "* \"Krocket-Rolle\" - Heilt 15 HP&* Gebäck, das standardmäßig mit&  Schlägel serviert wird./%"

msgid "* \"Stick\" - Weapon AT 0&* Its bark is worse than&  its bite./%"
msgstr "* \"Stock\" - Waffe AT 0&* Hunde die weiden^1,&  beißen nicht./%"

msgid "* \"Bandage\" - Heals 10 HP&* It has already been used&  several times./%"
msgstr "* \"Verband\" - Heilt 10 HP&* Wurde schon mehrfach&  eingesetzt./%"

msgid "* \"Rock Candy\" - Heals 1 HP&* Here is a recipe to make&  this at home:/"
msgstr "* \"Steinbonbon\" - Heilt 1 HP&* Hier ist ein Rezept für&  die häusliche Zubereitung:/"

msgid "* 1. Find a rock/%"
msgstr ""

msgid "* \"Pumpkin Rings\" - Heals 8 HP&* A small pumpkin cooked&  like onion rings./%"
msgstr "* \"Kürbisringe\" - Heilt 8 HP&* Ein Kürbis, der wie ein&  Zwiebelring angebraten wird./%"

msgid "* \"Spider Donut\" - Heals 12 HP&* A donut made with Spider&  Cider in the batter./%"
msgstr "* \"Spinnen-Donut\" - Heilt 12 HP&* Ein Donut mit Arachnosaft&  im Teig./%"

msgid "* \"Stoic Onion\" - Heals 5 HP&* Even eating it raw^1, the&  tears just won't come./%"
msgstr "* \"Stoische Zwiebel\" - Heilt 5 HP&* Selbst wenn man sie roh isst&  kommen keine Tränen./%"

msgid "* \"Ghost Fruit\" - Heals 16 HP&* If eaten^1, it will never&  pass to the other side./%"
msgstr "* \"Geisterfrucht\" - Heilt 16 HP&* Wenn man es isst kommt es&  nie zur anderen Seite./%"

msgid "* \"Spider Cider\" - Heals 24 HP&* Made with whole spiders^1,&  not just the juice./%"
msgstr "* \"Arachnosaft\" - Heilt 24 HP&* Aus ganzen Spinnen hergestellt^1,&  nicht nur aus deren Saft./%"

msgid "* \"Butterscotch Pie\" - All HP&* Butterscotch-cinnamon&  pie^1, one slice./%"
msgstr "* \"Karamell-Kuchen\" - Alle HP&* Ein Stück Karamell-Zimt-Kuchen./%"

msgid "* \"Faded Ribbon\" - Armor DF 3&* If you're cuter^1, monsters&  won't hit you as hard./%"
msgstr "* \"Alte Schleife\" - Rüstung DF 3&* Wenn du niedlicher bist werden&  dich Monster bestimmt schonen./%"

msgid "* \"Toy Knife\" - Weapon AT 3&* Made of plastic.&* A rarity nowadays./%"
msgstr "* \"Spielzeugmesser\" - Waffe AT 3&* Besteht aus Plastik.&* Heutzutage eine Rarität./%"

msgid "* \"Tough Glove\" - Weapon AT 5&* A worn pink leather glove^1.&* For five-fingered folk./%"
msgstr "* \"Harter Handschuh\" - Waffe AT 5&* Ein pinker Lederhandschuh^1.&* Für Wesen mit fünf Fingern./%"

msgid "* \"Manly Bandanna\" - Armor DF 7&* It has seen some wear.&* It has abs drawn on it./%"
msgstr "* \"Bandana\" - Rüstung DF 7&* Wurde oft getragen.&* Muskeln wurden aufgemalt./%"

msgid "* \"Snowman Piece\" - Heals 45 HP&* Please take this to the&  ends of the earth./%"
msgstr "* \"Schneemann-Teil\" - Heilt 45 HP&* Bitte trage es bis an&  das Ende der Welt./%"

msgid "* \"Nice Cream\" - Heals 15 HP&* Instead of a joke,^1 the&  wrapper says something nice./%"
msgstr "* \"Nice Cream\" - Heilt 15 HP&* Anstatt eines Witzes bekommt&  man ein Kompliment./%"

msgid "* \"Puppydough Icecream\"&* Heals 28 HP^1.&* Made by young pups./%"
msgstr "* \"Welpenteig-Eiscreme\"&* Heilt 28 HP^1.&* Aus Welpen hergestellt./%"

msgid "* \"Bisicle\" - Heals 11 HP&* It's a two-pronged popsicle^1,&  so you can eat it twice./%"
msgstr "* \"Duo-Eis\" - Heilt 11 HP&* Dieses doppelte Stieleis&  ist zweimal essbar./%"

msgid "* \"Unisicle\" - Heals 11 HP&* It's a SINGLE-pronged popsicle^1.&* Wait^1, that's just normal.../%"
msgstr "* \"Mono-Eis\" - Heilt 11 HP&* Eis mit EINEM ganzen Stiel^1.&* Moment^1,das ist ganz normal.../%"

msgid "* \"Cinnamon Bunny\" - Heals 22 HP&* A cinnamon roll in the shape&  of a bunny./%%"
msgstr "* \"Zimt-Hase\" - Heilt 22 HP&* Eine Zimtrolle in Form&  eines Hasen./%%"

msgid "* \"Temmie Flakes\" - Heals 2 HP&* It's just torn up pieces&  of colored construction paper./%%"
msgstr "* \"Temmie-Flakes\" - Heilt 2 HP&* Besteht aus zerstückelten,&  bunten Papier./%%"

msgid "* \"Abandoned Quiche\" Heals 34 HP&* A psychologically damaged&  spinach egg pie./%%\""
msgstr "* \"Verlassenens Quiche\" +34 HP&* Spinat-Ei-Kuchen mit&  psychischen Knacks./%%\""

msgid "* \"Old Tutu\" - Armor DF 10&* Finally^1, a protective piece&  of armor./%%"
msgstr "* \"Altes Tutu\" - Rüstung DF 10&* Endlich ein schützendes&  Rüstungsteil./%%"

msgid "* \"Ballet Shoes\" - Wpn AT 7&* These used shoes make you&  feel incredibly dangerous./%%"
msgstr "* \"Ballet-Schuhe\" - Waffe AT 7&* Diese benutzten Schuhe lassen&  dich sehr gefährlich wirken./%%"

msgid "* \"Punch Card\" - Battle Item&* Use to make punching attacks&  stronger in one battle./"
msgstr "* \"Hieb-Karte\" - Kampf Item&* Macht Schlagangriffe im Kampf&  stärker als gewöhnlich./"

msgid "* Use outside of battle to&  look at the card./%%"
msgstr "* Außerhalb des Kampfes nutzen^1,&  um die Karte anzusehen./%%"

msgid "* \"Annoying Dog\" - Dog&* A little white dog^1.&* It's fast asleep.../%%"
msgstr "* \"Nerviger Hund\" - Hund&* Ein kleiner weißer Hund^1.&* Er schläft tief und fest.../%%"

msgid "* \"Dog Salad\" - Heals ?? HP&* Recovers HP.&* (Hit Poodles.)/%%"
msgstr "* \"Hundesalat\" - Heilt ?? HP&* Stellt HP wieder her.&* (Trifft Pudel.)/%%"

msgid "* \"Dog Residue\" - Dog Item&* Shiny trail left&  behind by a dog./%%"
msgstr "* \"Hunde-Reste\" - Hund Item&* Glänzende Spur, zurückgelassen&  von einem Hund./%%"

msgid "* \"Dog Residue\" - Dog Item&* Dog-shaped husk shed&  from a dog's carapace./%%"
msgstr "* \"Hunde-Reste\" - Hund Item&* Hundeförmige Schale&  von einer Hundehütte./%%"

msgid "* \"Dog Residue\" - Dog Item&* Dirty dishes left&  unwashed by a dog./%%"
msgstr "* \"Hunde-Reste\" - Hund Item&* Dreckiges Geschirr,&  zurückgelassen von einem Hund./%%"

msgid "* \"Dog Residue\" - Dog Item&* Glowing crystals secreted&  by a dog./%%"
msgstr "* \"Hunde-Reste\" - Hund Item&* Leuchtende Kristalle versteckt&  von einem Hund./%%"

msgid "* \"Dog Residue\" - Dog Item&* Jigsaw puzzle left&  unfinished by a dog./%%"
msgstr "* \"Hunde-Reste\" - Hund Item&* Inkomplettes Puzzlespiel&  eines Hundes./%%"

msgid "* \"Dog Residue\" - Dog Item&* Web spun by a dog&  to ensnare prey./%%"
msgstr "* \"Hunde-Reste\" - Hund Item&* Von einem Hund gesponnenes&  Netz zum Beutefang./%%"

msgid "* \"Astronaut Food\" Heals 21 HP&* For feeding a pet&  astronaut./%%"
msgstr "* \"Astronauten-Futter\" Heilt 21HP&* Zum Füttern von&  Tier-Astronauten./%%"

msgid "* \"Instant Noodles\" Heals HP&* Comes with everything you&  need for a quick meal!/%%"
msgstr "* \"Instant Nudeln\" Heilt HP&* Mit allem, was ein schnelles&  Mahl benötigt!/%%"

msgid "* \"Crab Apple\" Heals 18 HP&* An aquatic fruit that&  resembles a crustacean./%%"
msgstr "* \"Johannisapfel\" Heilt 18 HP&* Eine aquatische Frucht die an&  Krustentiere erinnert./%%"

msgid "* \"Hot Dog...?\" Heals 20 HP&* The \"meat\" is made of something&  called a \"water sausage.\"/%%"
msgstr "* \"Hot Dog...?\" Heilt 20 HP&* Das \"Fleisch\" stammt von&  einem \"Rohrkolben\"./%%"

msgid "* \"Hot Cat\" Heals 21 HP&* Like a hot dog^1, but with&  little cat ears on the end./%%"
msgstr "* \"Hot Cat\" Heilt 21 HP&* Wie ein Hot Dog^1, aber mit&  kleinen Katzenohren am Ende./%%"

msgid "* \"Glamburger\" Heals 27 HP&* A hamburger made of edible&  glitter and sequins./%%"
msgstr "* \"Glamburger\" Heilt 27 HP&* Ein Hamburger aus leckeren&  Glitter und Pailletten./%%"

msgid "* \"Sea Tea\" Heals 10 HP&* Made from glowing marshwater.&* Increases SPEED for one battle./%%"
msgstr "* \"Meerestee\" Heilt 10 HP&* Aus leuchtendem Moorwasser.&* Erhöht INIT für einen Kampf./%%"

msgid "* \"Starfait\" Heals 14 HP&* A sweet treat made of&  sparkling stars./%%"
msgstr "* \"Sternen-Duft\" Heilt 14 HP&* Eine süße Leckerei aus&  leuchtenden Sternen./%%"

msgid "* \"Legendary Hero\" Heals 40 HP&* Sandwich shaped like a sword.&* Increases ATTACK when eaten./%%"
msgstr "* \"Legendärer Held\" Heilt 40 HP&* Sandwich in Schwert-Form.&* Erhöht ANGRIFF im Kampf./%%"

msgid "* \"Cloudy Glasses\" - Armor DF 6&* Glasses marred with wear.&* Increases INV by 9./"
msgstr "* \"Diffuse Brille\" - Rüstung DF 6&* Getrübte Glässer.&* Erhöht INV um 9./"

msgid "* (After you get hurt by an&  attack^1, you stay invulnerable&  for longer.)/%%"
msgstr "* (Nach einer Verletzung^1,&  Bleibst du länger unverletzt.)/%%"

msgid "* \"Torn Notebook\" - Weapon AT 2&* Contains illegible scrawls.&* Increases INV by 6./%"
msgstr "* \"Zerissenes Buch\" - Waffe AT 2&* Enthält unlesbare Kritzeleien.&* Erhöht INV um 6./%"

msgid "* \"Stained Apron\" - Armor DF 11&* Heals 1 HP every other&  turn./%"
msgstr "* \"Alte Schürze\" - Rüstung DF 11&* Heilt 1 HP pro Zug./%"

msgid "* \"Burnt Pan\" - Weapon AT 10&* Damage is rather consistent.&* Consumable items heal 4 more HP./%"
msgstr "* \"Bratpfanne\" - Waffe AT 10&* Konstanter Schaden.&* Items heilen 4 HP extra./%"

msgid "* \"Cowboy Hat\" - Armor DF 12&* This battle-worn hat makes you&  want to grow a beard./"
msgstr "* \"Cowboy-Hut\" - Rüstung DF 12&* Dieser kampferprobte Hut schürt&  das Verlangen nach einem Bart./"

msgid "* It also raises ATTACK by 5./%"
msgstr "* Erhöht zusätzlich ANGRIFF um 5./%"

msgid "* \"Empty Gun\" - Weapon AT 12&* An antique revolver^1.&* It has no ammo./"
msgstr "* \"Leere Pistole\" - Waffe AT 12&* Ein antiker Revolver^1.&* Er ist nicht geladen./"

msgid "* Must be used precisely, or&  damage will be low./%"
msgstr "* Muss präzise verwendet werden,&  ansonsten ist der&  Schaden gering./%"

msgid "* \"Heart Locket\" - Armor DF 15&* It says \"Best Friends Forever.\"/%"
msgstr "* \"Herz-Anhänger\" - Rüstung DF 15&* Die Inschrift besagt&  \"Beste Freunde für immer.\"/%"

msgid "* \"Worn Dagger\" - Weapon AT 15&* Perfect for cutting plants&  and vines./%"
msgstr "* \"Rostiges Messer\" - Waffe AT 15&* Perfekt um Pflanzen und&  Lianen zu zerschneiden./%"

msgid "* \"Real Knife\" - Weapon AT 99&* Here we are!/%"
msgstr "\\W* \"Echtes Messer\" - Waffe AT 99&\\R* Das nenne ich Messer!\\W/%"

msgid "* \"The Locket\" - Armor DF 99&* You can feel it beating./%"
msgstr "* \"Der Anhänger\" - Rüstung DF 99&* Du kannst es schlagen hören./%"

msgid "* \"Bad Memory\" Hurts 1 HP&* ?????/%%"
msgstr "* \"Böse Erinnerung\" Verletzt 1 HP&* ?????/%%"

msgid "* \"Dream\" Heals 12 HP&* The goal of \"Determination.\"/%%"
msgstr "* \"Traum\" Heilt 12 HP&* Das Ziel der&  \"Entschlossenheit.\"/%%"

msgid "* \"Undyne's Letter\" - Unique&* Letter written for Dr.&  Alphys./%%"
msgstr "* \"Undynes Brief\" - Unikat&* Ein Brief für Dr.Alphys./%%"

msgid "* \"Undyne's Letter EX\" - Unique&* It has DON'T DROP IT&  written on it./%%"
msgstr "* \"Undynes Brief EX\" - Unikat&* NICHT WEGWERFEN steht auf&  dem Umschlag./%%"

msgid "* \"Popato Chisps\" Heals 13 HP&* Regular old popato chisps./%%"
msgstr "* \"Toffel-Chips\" Heilt 13 HP&* Einfache Toffel-Chips./%%"

msgid "* \"Junk Food\" Heals 17 HP&* Food that was probably&  once thrown away./%%"
msgstr "* \"Junk-Food\" Heilt 17 HP&* Essen das vermutlich schon&  einmal weggeworfen wurde./%%"

msgid "* \"Mystery Key\" Unique&* It is too bent to fit on&  your keychain./%%"
msgstr "* \"Mystery Key\" Unikat&* Er ist zu verbogen, um an&  deinen Anhänger zu passen./%%"

msgid "* \"Face Steak\" Heals 60 HP&* Huge steak in the shape&  of Mettaton's face./"
msgstr "* \"Gesicht-Steak\" Heilt 60 HP&* Ein riesiges Steak in der&  Form von Mettatons Gesicht./"

msgid "* (You don't feel like it's&  made of real meat...)/%%"
msgstr "* (Es scheint nicht aus&  echtem Fleisch zu sein...)/%%"

msgid "* \"Hush Puppy\" Heals 65 HP&* This wonderful spell will stop&  a dog from casting magic./%%"
msgstr "* \"Hush Puppy\" Heilt 65 HP&* Dieser mächtige Zauber&  verhindert Magie von Hunden./%%"

msgid "* \"Snail Pie\" - Heals Some HP&* An acquired taste./%%"
msgstr "* \"Schneckenkuchen\" - Heilt HP&* Ein exquisiter Geschmack./%%"

msgid "* \"temy armor\" - Armor DF 20&* The things you can do with&  a college education!/"
msgstr "* \"Temy Rüstung\" - Rüstung DF 20&* Alles was ein Universitäts-&  Abschluss möglich macht!/"

msgid "* Raises ATTACK when worn^1.&* Recovers HP every other turn^1.&* INV up slightly./%%"
msgstr "* Erhöht deinen ANGRIFF^1.&* Stellt HP wieder her^1.&* Erhöht INV./%%"

